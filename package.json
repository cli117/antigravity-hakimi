{
  "name": "antigravity-hakimi",
  "version": "1.0.0",
  "description": "macOS standalone 哈基米.app patcher for Apple Silicon (arm64) and Intel (x86_64) with region unlock, context & token viewer, and UI localization",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "pretest": "node scripts/build-renderer.js",
    "test": "node --test test/*.test.js",
    "build:hakimi": "bash ./build-hakimi.sh",
    "set-icon": "bash ./set-hakimi-icon.sh",
    "unlock:cli": "node scripts/cli-unlock.js --apply",
    "doctor": "node scripts/doctor.js"
  },
  "keywords": [
    "antigravity",
    "hakimi",
    "macos",
    "arm64",
    "context-viewer",
    "context-window",
    "token-tracker",
    "region-unlock",
    "x64",
    "intel"
  ],
  "license": "MIT"
}
